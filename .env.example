# Example environment configuration for local development.
# Copy to ".env" and fill in the values.

# --- db_manager (ETL) ---
PGHOST=localhost
PGPORT=5432
PGDBNAME=hydro
PGUSER=postgres
PGPASSWORD=changeme

# Optional schema name (if used by your tooling)
SCHEMA=hydro

# Optional ingestion pacing
HEARTBEAT_SECONDS=60

# --- Django (portale) ---
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost or ip addresses
CSRF_TRUSTED_ORIGINS=

DJANGO_DB_NAME=name of your database
DJANGO_DB_USER=user with access to the database
DJANGO_DB_PASSWORD=password for the database user
DJANGO_DB_HOST=the host where your database is running (e.g., localhost or the IP address of the database server)
DJANGO_DB_PORT=the port on which your database is listening (default is usually 5432 for PostgreSQL)
DJANGO_DB_OPTIONS=-c search_path= schema_name (optional, if you are using a specific schema in your database)
